# Local development only. Copy to .env.local and fill with your own provider credentials.
# Never commit real credentials.

# MCP Structured Observability：只向 stderr 输出脱敏后的 Tool/Capability/耗时/状态元数据。
# stdout 保留给 MCP transport；设为 0 可关闭本地运行事件。
SEO_OBSERVABILITY_ENABLED=1

# OrganicVisibility / DataForSEO. Sandbox is free but returns dummy data only.
DATAFORSEO_API_BASE_URL=https://api.dataforseo.com
DATAFORSEO_SANDBOX_BASE_URL=https://sandbox.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 1/true 仅用于开发；Sandbox 免费但返回 dummy data。
DATAFORSEO_USE_SANDBOX=0
DATAFORSEO_REQUEST_TIMEOUT=30
# DataForSEO Labs 数据本身按周更新；本地默认缓存 24 小时，避免同一查询反复计费。
DATAFORSEO_CACHE_TTL_SECONDS=86400

# 付费/远程 Provider 短期响应缓存。Cache 用于减少重复 API 请求；不是趋势历史。
# 默认写入 ${PLUGIN_DATA:-.local}/cache/providers/，不进入 Git。
PROVIDER_CACHE_ENABLED=1
PROVIDER_CACHE_DIR=

# Provider 成本 admission：标准成本可自动执行；1x~10x 需要可信用户批准；>10x 直接阻断。
# Human approval 通过 MCP hidden resolver / elicitation 获取，不是普通 Tool 参数。
PROVIDER_AUTO_COST_MULTIPLIER_LIMIT=1
PROVIDER_APPROVAL_COST_MULTIPLIER_LIMIT=10

# 本地周趋势：成功拿到第三方自然搜索可见性聚合后，每个 target/market/provider 每周保留一条。
# 默认写入 ${PLUGIN_DATA:-.local}/snapshots/organic-visibility/，不进入 Git。
ORGANIC_VISIBILITY_SNAPSHOTS_ENABLED=1
ORGANIC_VISIBILITY_SNAPSHOT_RETENTION_WEEKS=104
# 可选自定义目录；留空使用上面的默认路径。
ORGANIC_VISIBILITY_SNAPSHOT_DIR=

SERPER_API_BASE_URL=
SERPER_API_KEY=

# OrganicVisibility / Ahrefs optional BYOK adapter.
AHREFS_API_BASE_URL=https://api.ahrefs.com
AHREFS_API_KEY=
AHREFS_REQUEST_TIMEOUT=30

# PageQuality / PageSpeed Insights（开发期可无 Key，自动化调用建议配置）
PAGESPEED_API_BASE_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed
PAGESPEED_API_KEY=
PAGESPEED_REQUEST_TIMEOUT=60
# 同 URL + strategy 的 Lighthouse 短期缓存，减少重复额度消耗；0 表示禁用。
PAGESPEED_CACHE_TTL_SECONDS=1800

# PageQuality / CrUX Field（免费 API，但需要 Google Cloud API Key）
CRUX_API_KEY=
# CrUX 是 28 天滚动真实用户数据，默认缓存 24 小时；0 表示禁用。
CRUX_CACHE_TTL_SECONDS=86400

# SiteSafety / Google Safe Browsing V5（仅适合个人/非商业用途）。
# 商业/收费分发时保持 SiteSafety Contract，Provider 切换到 Google Cloud Web Risk。
SAFE_BROWSING_API_BASE_URL=https://safebrowsing.googleapis.com/v5/urls:search
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_REQUEST_TIMEOUT=15
# Safe Browsing v5 会返回 cacheDuration；本值只作为本地缓存最大上限。
SAFE_BROWSING_CACHE_MAX_TTL_SECONDS=86400

# Optional first-party enhancement: Google Search Console Desktop OAuth.
# 推荐：直接使用 Google Cloud 下载的 Desktop OAuth Client JSON。
GOOGLE_OAUTH_CLIENT_FILE=
# 可选 fallback：企业 Host / CI 可拆成环境变量。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 可选：默认写入 ${PLUGIN_DATA:-.local}/credentials/gsc.json
GSC_TOKEN_PATH=
# Desktop OAuth loopback；通常不需要修改。
GSC_OAUTH_LOOPBACK_HOST=127.0.0.1
GSC_OAUTH_TIMEOUT_SECONDS=120

# Google Analytics 4 / WebAnalytics（只读）。
# GA4 与 GSC 复用上面的 GOOGLE_OAUTH_CLIENT_FILE / google-oauth-client.json Desktop OAuth Client；
# scope 与 refresh token 仍独立。Codex Desktop 使用 localhost loopback，不需要固定公网 callback URL。
# 可选 fallback：仅在没有 Desktop Client JSON 时使用独立 ID/Secret。
GOOGLE_GA4_CLIENT_ID=
GOOGLE_GA4_CLIENT_SECRET=
# 可选：默认写入 ${PLUGIN_DATA:-.local}/credentials/ga4.json
# 首次在 Host 中运行且默认目标不存在时，导入插件自身 .local 中同 OAuth Client、
# 含 analytics.readonly scope 的 GA4 授权；不覆盖已有授权。显式 GA4_TOKEN_PATH
# 或 CODEX_SEO_DATA_DIR 会禁用此迁移；旧文件保留，后续刷新只写持久目录。
# 默认 google-oauth-client.json 同样缺失时，一并导入匹配的本地 Desktop Client；
# 已有客户端文件或显式 GOOGLE_OAUTH_CLIENT_FILE 优先。
GA4_TOKEN_PATH=
# Desktop OAuth loopback；通常不需要修改，也不需要额外配置 GA4_CALLBACK_URL。
GA4_OAUTH_LOOPBACK_HOST=127.0.0.1
GA4_OAUTH_TIMEOUT_SECONDS=120
# GA4 Data/Admin REST endpoints；通常不需要修改。
GA4_DATA_API_BASE_URL=https://analyticsdata.googleapis.com/v1beta
GA4_ADMIN_API_BASE_URL=https://analyticsadmin.googleapis.com/v1beta
GA4_REQUEST_TIMEOUT_SECONDS=30
# GA4 Data API 报表短期缓存；同一 property/report 在短时间内避免重复消耗 quota。
GA4_CACHE_TTL_SECONDS=1800

# Semrush：v3/v4 Key 官方明确版本隔离；优先配置具体版本。
SEMRUSH_BASE_URL=https://api.semrush.com
SEMRUSH_V3_API_KEY=
SEMRUSH_V4_API_KEY=
# 开发兼容 fallback；无法替代正式的版本化 Key 配置。
SEMRUSH_API_KEY=
SEMRUSH_REQUEST_TIMEOUT=30
# Semrush 关键词列表默认最多返回 20 个；用户明确指定数量时由 Tool 参数覆盖。
SEMRUSH_DEFAULT_KEYWORD_LIMIT=20
# Semrush 请求通常消耗 API units；默认缓存 6 小时，可设为 0 禁用 Semrush 缓存。
SEMRUSH_CACHE_TTL_SECONDS=21600
